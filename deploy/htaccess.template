# mukbuddy.com production .htaccess — VERSIONED TEMPLATE.
#
# This is the source of truth. The autopublish deploy compares the live docroot
# .htaccess against this file every run and restores from it on drift, so any
# hand-edit on the server WILL be reverted. Change it here, commit, and let the
# deploy carry it.
#
# History: an untracked hand-edit on 2026-07-02 replaced player.vimeo.com in the
# frame-src allowlist with the two YouTube origins instead of appending to it.
# That silently broke the product video on the paid /ads landing page for five
# weeks, because nothing validated this file. Hence: versioned, plus a
# post-deploy CSP smoke check that fails loudly.
#
# frame-src must list EVERY third-party frame origin the frontend embeds.
# Adding a new video host? Add it here in the same commit, or the smoke check
# will fail the deploy report.

# Force www -> non-www
RewriteEngine On

# --- BEGIN sourcemap-deny (audit 2026-07-02): block published JS/CSS source maps ---
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
# --- END sourcemap-deny ---
RewriteCond %{HTTP_HOST} ^www\.mukbuddy\.com$ [NC]
RewriteRule ^(.*)$ https://mukbuddy.com/$1 [R=301,L]

# --- BEGIN api-proxy (2026-11-22, Jed): lead-form API served on the site's own address ---
# The home page and /ads forms POST to https://mukbuddy.com/api/leads. Apache hands /api/*
# to the FastAPI app on this same server (uvicorn 127.0.0.1:8001). This replaced the old
# mukbuddy-api.tal.one Cloudflare tunnel, which sat on a former employee's personal account.
RewriteRule ^api/(.*)$ http://127.0.0.1:8001/api/$1 [P,L]
# --- END api-proxy ---

# --- BEGIN yt-tracking-redirects (2026-11-25, seo-operator-mukbuddy for Jed) ---
# /yt/<n> short links used in YouTube descriptions. 302 (not 301) so the target
# can change later. Kept out of the sitemap; X-Robots-Tag noindex set below.
RewriteRule ^yt/1/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=ylEdUGT4G6o [R=302,NE,L]
RewriteRule ^yt/2/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=HZDdLH8tttQ [R=302,NE,L]
RewriteRule ^yt/3/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=9A_fwrGo4a4 [R=302,NE,L]
RewriteRule ^yt/4/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=S1Vb_XFW7fY [R=302,NE,L]
RewriteRule ^yt/5/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=a-AMZJtoHik [R=302,NE,L]
RewriteRule ^yt/6/?$ https://mukbuddy.com/ads/?utm_source=youtube&utm_medium=video&utm_content=jUr0UwyQN00 [R=302,NE,L]
# --- END yt-tracking-redirects ---

# --- BEGIN index-html-canonical (FIX 1 Jed 2026-09-14; re-added 2026-11-20): /index.html -> / ---
# Use THE_REQUEST so DirectoryIndex internal rewrites do not loop.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://mukbuddy.com/ [R=301,L]
# --- END index-html-canonical ---

# --- BEGIN blog-redirects: 301 redirects for consolidated blog posts ---
# Cannibalization fix: use-shop-vacuum-without-bag → do-you-need-a-bag-in-a-shop-vac
RewriteRule ^blog/use-shop-vacuum-without-bag/?$ /blog/do-you-need-a-bag-in-a-shop-vac/ [R=301,L]
# Cannibalization fix (2026-11-20): shop-vacuum-lost-suction -> shop-vac-lost-suction-how-to-fix
Redirect 301 /blog/shop-vacuum-lost-suction/ https://mukbuddy.com/blog/shop-vac-lost-suction-how-to-fix/
# --- END blog-redirects ---

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com;"
</IfModule>

# Noindex the paid /ads landing page
<If "%{REQUEST_URI} =~ m#^/ads/?#">
  Header set X-Robots-Tag "noindex, follow"
</If>

# Noindex the /yt/ tracking redirects ("always" so it rides on the 302)
<If "%{REQUEST_URI} =~ m#^/yt/#">
  Header always set X-Robots-Tag "noindex, nofollow"
</If>
